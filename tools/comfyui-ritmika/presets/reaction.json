{
  "name": "reaction",
  "description": "Short expressive reaction clips for characters. Non-looping, stronger motion than idle.",
  "category": "*",
  "model": {
    "checkpoint": "v1-5-pruned-emaonly.safetensors",
    "motionModel": "mm_sd_v15_v2.ckpt",
    "interpModel": "rife_v4.26.safetensors"
  },
  "resolution": {
    "maxDimension": 640,
    "minDimension": 256,
    "multipleOf": 8
  },
  "alpha": {
    "required": true,
    "mode": "source",
    "method": "source-alpha-reapply",
    "compositeBackground": "#808080"
  },
  "prompt": {
    "subject": "cute 3D cartoon character, clean render, centered",
    "negative": "photorealistic, human, multiple characters, cropped character, cut off limbs"
  },
  "generation": {
    "denoise": 0.52,
    "frames": 14,
    "loopMode": "none"
  },
  "outputs": {
    "webm": true,
    "webp": true,
    "spriteSheet": true,
    "previewMp4": true,
    "previewPng": true
  }
}
