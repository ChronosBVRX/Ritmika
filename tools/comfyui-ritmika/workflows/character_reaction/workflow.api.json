{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT__" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "__INPUT_IMAGE__", "upload": "image" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__POSITIVE__", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["1", 1] }
  },
  "5": {
    "class_type": "ADE_AnimateDiffUniformContextOptions",
    "inputs": {
      "context_length": "__CONTEXT_LENGTH__",
      "context_stride": 1,
      "context_overlap": "__CONTEXT_OVERLAP__",
      "context_schedule": "uniform",
      "closed_loop": "__CLOSED_LOOP__",
      "fuse_method": "flat"
    }
  },
  "6": {
    "class_type": "ADE_AnimateDiffLoaderWithContext",
    "inputs": {
      "model": ["1", 0],
      "model_name": "__MOTION_MODEL__",
      "beta_schedule": "sqrt_linear (AnimateDiff)",
      "context_options": ["5", 0],
      "motion_scale": "__MOTION_SCALE__",
      "apply_v2_models_properly": true
    }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["2", 0], "vae": ["1", 2] }
  },
  "8": {
    "class_type": "RepeatLatentBatch",
    "inputs": { "samples": ["7", 0], "amount": "__FRAMES__" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["8", 0],
      "denoise": "__DENOISE__"
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["1", 2] }
  },
  "11": {
    "class_type": "FrameInterpolationModelLoader",
    "inputs": { "model_name": "__INTERP_MODEL__" }
  },
  "12": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": ["11", 0],
      "images": ["10", 0],
      "multiplier": "__INTERP_MULTIPLIER__"
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": { "images": ["12", 0], "filename_prefix": "__PREFIX__" }
  }
}
